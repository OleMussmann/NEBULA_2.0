---
// Hub: modules grouped by category (config.json categoryOrder), visible only.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection } from 'astro:content';
import { categories } from '../nebula.mjs';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const modules = (await getCollection('docs', (e) => e.data.module && e.id === `modules/${e.data.module}`))
	.filter((e) => (e.data.visibility ?? 'visible') === 'visible');
const cats = categories({
	categoryOrder: (await import('../../../content/config.json')).default.publicProps.categoryOrder,
	modules: modules.map((e) => ({ meta: e.data })),
});
const title = (await import('../../../content/config.json')).default.publicProps.title;
---

<StarlightPage frontmatter={{ title, tableOfContents: false }}>
	{
		cats.map((cat) => (
			<section>
				<h2>{cat}</h2>
				<div class="hub-cards not-content">
					{modules
						.filter((e) => e.data.category === cat)
						.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
						.map((e) => (
							<a class="hub-card" href={`${base}/${e.id}.html`}>
								{e.data.thumbnail && (
									<img src={`${base}/modules/${e.data.module}/media/${e.data.thumbnail}`} alt="" loading="lazy" />
								)}
								<span class="hub-card-title">{e.data.title}</span>
								<span class="hub-card-text">{e.data.abstract}</span>
							</a>
						))}
				</div>
			</section>
		))
	}
</StarlightPage>
